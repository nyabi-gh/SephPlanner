<Project>
  <PropertyGroup>
    <!-- 배포 버전. 릴리스 zip 이름과 어셈블리 버전이 여기서 나온다. -->
    <Version>0.3.2</Version>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <PropertyGroup>
    <!--
      게임 설치 경로. 우선순위: 환경변수 SEPHIRIA_DIR > 기본 Steam 경로.
      플러그인 프로젝트가 게임 어셈블리를 참조할 때만 필요하다.
      이 경로의 DLL은 참조만 하고 저장소에 커밋하지 않는다.
    -->
    <SephiriaDir Condition="'$(SephiriaDir)' == '' AND '$(SEPHIRIA_DIR)' != ''">$(SEPHIRIA_DIR)</SephiriaDir>
    <SephiriaDir Condition="'$(SephiriaDir)' == ''">D:\SteamLibrary\steamapps\common\Sephiria</SephiriaDir>
    <SephiriaManagedDir>$(SephiriaDir)\Sephiria_Data\Managed</SephiriaManagedDir>
  </PropertyGroup>
</Project>
