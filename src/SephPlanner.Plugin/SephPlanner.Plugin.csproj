<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>SephPlanner.Plugin</AssemblyName>
    <RootNamespace>SephPlanner.Plugin</RootNamespace>
    <!-- 게임 DLL을 참조만 하고 출력 폴더로 복사하지 않는다. 배포물에 게임 저작물이 섞이면 안 된다. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Core" Version="5.4.21" />
    <!-- 피드의 최신 5.x 패키지. 사용자가 설치할 런타임은 BepInEx 5.4.23.5 -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SephPlanner.Core\SephPlanner.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 손으로 채운 아티팩트 가치. 오버레이와 같은 파일을 같은 이름으로 품는다 - 한쪽만 읽으면
         같은 배치를 두고 두 화면이 다른 점수를 말한다. -->
    <EmbeddedResource Include="..\..\data\values\charms.json" LogicalName="SephPlanner.Values.Charms.json" />
  </ItemGroup>

  <!-- 게임 어셈블리 참조. SEPHIRIA_DIR 환경변수로 경로를 바꿀 수 있다. -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(SephiriaManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Mirror">
      <HintPath>$(SephiriaManagedDir)\Mirror.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(SephiriaManagedDir)\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(SephiriaManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(SephiriaManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(SephiriaManagedDir)\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- 게임 HUD 캔버스 안에 직접 그리기 위한 것. 게임과 같은 uGUI + TextMeshPro 를 쓴다. -->
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(SephiriaManagedDir)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(SephiriaManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(SephiriaManagedDir)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(SephiriaManagedDir)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!--
      이동 모드에서 커서 위치를 읽는다. 게임이 새 InputSystem 을 쓰므로 그쪽을 먼저 보고,
      구식 Input 은 BepInEx 단축키가 쓰는 길이라 폴백으로 남긴다.
    -->
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(SephiriaManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.InputSystem">
      <HintPath>$(SephiriaManagedDir)\Unity.InputSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!--
      클립보드(GUIUtility.systemCopyBuffer). 게임도 프리셋 코드를 클립보드로 주고받으므로,
      빌드 창은 입력 칸 없이 복사해 둔 코드를 그대로 받는다.
    -->
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(SephiriaManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="WarnIfGameMissing" BeforeTargets="ResolveAssemblyReferences">
    <Warning Condition="!Exists('$(SephiriaManagedDir)\Assembly-CSharp.dll')"
             Text="세피리아 설치 경로를 찾을 수 없습니다 ($(SephiriaManagedDir)). SEPHIRIA_DIR 환경변수를 설정하세요." />
  </Target>
  <!-- 게임에 BepInEx 가 설치돼 있으면 빌드할 때 바로 배치한다. -->
  <Target Name="DeployToGame" AfterTargets="Build" Condition="Exists('$(SephiriaDir)\BepInEx\plugins')">
    <Copy SourceFiles="$(TargetPath);$(TargetDir)SephPlanner.Core.dll"
          DestinationFolder="$(SephiriaDir)\BepInEx\plugins" />
  </Target>

</Project>
