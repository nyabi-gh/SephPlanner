<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>SephPlanner.Plugin</AssemblyName>
    <RootNamespace>SephPlanner.Plugin</RootNamespace>
    <!-- 게임 DLL을 참조만 하고 출력 폴더로 복사하지 않는다. 배포물에 게임 저작물이 섞이면 안 된다. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Core" Version="5.4.21" />
    <!-- 피드의 최신 5.x 패키지. 사용자가 설치할 런타임은 BepInEx 5.4.23.5 -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SephPlanner.Core\SephPlanner.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 손으로 채운 아티팩트 가치를 런타임에서 읽도록 DLL에 포함한다. -->
    <EmbeddedResource Include="..\..\data\values\charms.json" LogicalName="SephPlanner.Values.Charms.json" />
  </ItemGroup>

  <Import Project="..\GameReferences.props" />

  <!-- 배치할 곳이 없으면 멈춘다. 조건으로 건너뛰면 아무것도 안 하고 성공해, 옛 빌드로 시험하게 된다. -->
  <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(DeployToGame)' == 'true'">
    <Error Condition="!Exists('$(SephiriaDir)/BepInEx/plugins')"
           Text="BepInEx plugins 폴더가 없습니다 ($(SephiriaDir)/BepInEx/plugins). SEPHIRIA_DIR 환경변수를 확인하세요." />
    <Copy SourceFiles="$(TargetPath);$(TargetDir)SephPlanner.Core.dll"
          DestinationFolder="$(SephiriaDir)/BepInEx/plugins" />
  </Target>

</Project>
