<Project Sdk="Microsoft.NET.Sdk">
  <!-- 창작마당 판. 게임 1.1 이상의 Managed 로만 빌드된다(WorkshopModBase 가 1.1.0 에 생겼다). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <!--
      0.6.6 까지의 BepInEx 판과 같은 이름이다. 그 판이 아직 깔려 있으면 BepInEx 가 먼저 싣고, 게임의 모드 로더는 같은 이름의
      어셈블리가 이미 있으면 이 판을 보류한다(1.1.1 WorkshopDllActivator.TryLoadAssembly). 그래서 플래너가 둘 뜨는 일이 없다.
    -->
    <AssemblyName>SephPlanner.Plugin</AssemblyName>
    <RootNamespace>SephPlanner.Plugin</RootNamespace>
    <!-- 게임 DLL을 참조만 하고 출력 폴더로 복사하지 않는다. 배포물에 게임 저작물이 섞이면 안 된다. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <WorkshopPackageDir>$(MSBuildThisFileDirectory)..\..\artifacts\workshop\sephplanner\</WorkshopPackageDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SephPlanner.Core\SephPlanner.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 손으로 채운 아티팩트 가치를 런타임에서 읽도록 DLL에 포함한다. -->
    <EmbeddedResource Include="..\..\data\values\charms.json" LogicalName="SephPlanner.Values.Charms.json" />
    <None Remove="package\**" />
    <None Remove="workshop-description.txt" />
  </ItemGroup>

  <Import Project="..\GameReferences.props" />

  <!-- 게임에 든 Lib.Harmony 2.4.3 을 참조만 한다. 모드에 넣은 0Harmony.dll 은 게임이 무시한다(공식 모드 가이드). -->
  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(SephiriaManagedDir)/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!--
    창작마당 패키지 폴더를 짓는다: package 의 썸네일, bin 의 DLL 둘, 그리고 package/metadata.json 에 설명글
    (workshop-description.txt)을 넣은 것. pdb 는 넣지 않는다 - 패키지 안의 파일은 모두 검수 대상이다. 게임이 그 폴더에 만든
    uploadticket.json 은 지우지 않는다(창작마당 글 번호를 든다). metadata.json 의 version 은 손으로 적고 scripts/check.ps1 이
    Directory.Build.props 와 대조한다.

    게임은 올릴 때마다 info.description 의 default 를 Steam 글 설명으로 다시 쓰고, 게임 안 모드 창에는 게임 언어의 항목을 쓰며
    없으면 default 로 물러선다(1.1.4 WorkshopUploadPreparer·WorkshopLocalizedText.Resolve). 그래서 default 에 BBCode 설명글을
    넣고, 우리가 쓰지 않은 게임 언어(1.1.4 의 StreamingAssets/Localization)에는 영어 짧은 설명을 채워 모드 창에 BBCode 가
    드러나지 않게 한다. JSON 은 게임 폴더의 Newtonsoft.Json 으로 다룬다 - 인라인 작업에는 System.Text.Json 이 없고, 빌드 안에서
    셸을 따로 띄우면 그 셸의 런타임이 기계마다 달라 깨진다.
  -->
  <UsingTask TaskName="WriteWorkshopMetadata" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Source ParameterType="System.String" Required="true" />
      <Description ParameterType="System.String" Required="true" />
      <Destination ParameterType="System.String" Required="true" />
      <GameLanguages ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Reference Include="$(SephiriaManagedDir)/Newtonsoft.Json.dll" />
      <Using Namespace="System.IO" />
      <Using Namespace="Newtonsoft.Json" />
      <Using Namespace="Newtonsoft.Json.Linq" />
      <Code Type="Fragment" Language="cs"><![CDATA[
var root = JObject.Parse(File.ReadAllText(Source));
var description = (JObject)root["info"]["description"];
var english = (string)description["en-US"];
foreach (var language in GameLanguages.Split(';'))
{
    if (description[language] == null) description[language] = english;
}
var text = File.ReadAllText(Description).Replace("\r\n", "\n").Trim();
// 게임이 이보다 길면 올리기를 거절한다(WorkshopUploadPreparer).
if (text.Length > 7999)
{
    Log.LogError("창작마당 설명글이 7999자를 넘습니다(" + text.Length + "자): " + Description);
    return false;
}
description["default"] = text;
Directory.CreateDirectory(Path.GetDirectoryName(Destination));
File.WriteAllText(Destination, root.ToString(Formatting.Indented).Replace("\r\n", "\n") + "\n");
]]></Code>
    </Task>
  </UsingTask>

  <Target Name="PackWorkshop" AfterTargets="Build" Condition="'$(PackWorkshop)' == 'true'">
    <ItemGroup>
      <WorkshopStatic Include="$(MSBuildThisFileDirectory)package/**/*" Exclude="$(MSBuildThisFileDirectory)package/metadata.json" />
    </ItemGroup>
    <Copy SourceFiles="@(WorkshopStatic)" DestinationFiles="@(WorkshopStatic->'$(WorkshopPackageDir)%(RecursiveDir)%(Filename)%(Extension)')" />
    <WriteWorkshopMetadata Source="$(MSBuildThisFileDirectory)package/metadata.json"
                           Description="$(MSBuildThisFileDirectory)workshop-description.txt"
                           Destination="$(WorkshopPackageDir)metadata.json"
                           GameLanguages="de-DE;en-US;es-ES;fr-FR;it-IT;ja-JP;ko-KR;pl-PL;pt-BR;ru-RU;sv-SE;th-TH;tr-TR;zh-CN;zh-TW" />
    <Copy SourceFiles="$(TargetPath);$(TargetDir)SephPlanner.Core.dll" DestinationFolder="$(WorkshopPackageDir)bin" />
  </Target>

  <!-- 로컬 시험용. WorkshopLocal 의 모드는 기본으로 켜지지만, 로드된 게임에서는 멀티가 막힌다(공식 가이드). -->
  <Target Name="DeployToWorkshopLocal" AfterTargets="PackWorkshop" Condition="'$(DeployToWorkshopLocal)' == 'true'">
    <ItemGroup>
      <WorkshopPackageFile Include="$(WorkshopPackageDir)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(WorkshopPackageFile)" DestinationFiles="@(WorkshopPackageFile->'$(SephiriaDir)/WorkshopLocal/sephplanner/%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
</Project>
