<Window x:Class="SephPlanner.Overlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SephPlanner"
        Width="260" Height="420"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize">

    <Border Background="#E6141118" CornerRadius="10" Padding="12" BorderBrush="#3A3244" BorderThickness="1"
            MouseLeftButtonDown="OnDragArea">
        <StackPanel>
            <DockPanel LastChildFill="False" Margin="0,0,0,10">
                <TextBlock Text="SephPlanner" Foreground="#EDE7F6" FontSize="13" FontWeight="SemiBold" />
                <TextBlock x:Name="StatusText" DockPanel.Dock="Right" Text="게임 대기 중"
                           Foreground="#8A7FA6" FontSize="11" VerticalAlignment="Center" />
            </DockPanel>

            <!-- 인벤토리 격자. 셀 안 숫자는 석판 효과가 반영된 최종 레벨이다. -->
            <ItemsControl x:Name="GridCells">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid x:Name="CellPanel" Columns="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="2" Height="36" CornerRadius="4"
                                Background="{Binding Background}" BorderBrush="#2A2434" BorderThickness="1">
                            <TextBlock Text="{Binding Label}" Foreground="{Binding Foreground}"
                                       FontSize="12" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="HintText" Margin="0,10,0,0" TextWrapping="Wrap"
                       Foreground="#8A7FA6" FontSize="11"
                       Text="게임을 실행하면 자동으로 연결됩니다." />
        </StackPanel>
    </Border>
</Window>
