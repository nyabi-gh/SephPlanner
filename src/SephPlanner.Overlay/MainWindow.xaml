<Window x:Class="SephPlanner.Overlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SephPlanner"
        Width="200" SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize">

    <Border Background="#F0141118" CornerRadius="10" Padding="14" BorderBrush="#3A3244" BorderThickness="1"
            MouseLeftButtonDown="OnDragArea">
        <StackPanel>
            <DockPanel LastChildFill="False">
                <TextBlock Text="SephPlanner" Foreground="#EDE7F6" FontSize="13" FontWeight="SemiBold" />
                <Button DockPanel.Dock="Right" Content="✕" Click="OnClose" Width="18" Height="18"
                        Margin="6,0,0,0" Padding="0" BorderThickness="0" Cursor="Hand"
                        Background="Transparent" Foreground="#6B6285" FontSize="11" ToolTip="닫기 (Esc)" />
                <Button x:Name="ExpandButton" DockPanel.Dock="Right" Content="⌄" Click="OnToggleDetail"
                        Width="18" Height="18" Margin="6,0,0,0" Padding="0" BorderThickness="0" Cursor="Hand"
                        Background="Transparent" Foreground="#8A7FA6" FontSize="12" />
                <TextBlock x:Name="StatusText" DockPanel.Dock="Right" Text="게임 대기 중"
                           Foreground="#8A7FA6" FontSize="11" VerticalAlignment="Center" />
            </DockPanel>

            <TextBlock x:Name="NoticeText" Margin="0,10,0,0" TextWrapping="Wrap"
                       Foreground="#C9A227" FontSize="11" Visibility="Collapsed" />

            <StackPanel x:Name="ScorePanel" Orientation="Horizontal" Margin="0,12,0,0" Visibility="Collapsed">
                <TextBlock x:Name="CurrentScoreText" Foreground="#8A7FA6" FontSize="22" FontWeight="Bold" />
                <TextBlock Text="→" Foreground="#5A5170" FontSize="15" Margin="8,6,8,0" />
                <TextBlock x:Name="BestScoreText" Foreground="#EDE7F6" FontSize="22" FontWeight="Bold" />
                <TextBlock x:Name="GainText" Foreground="#7BD88F" FontSize="12" Margin="8,9,0,0" />
            </StackPanel>

            <!-- 접었을 때는 다음 한 수만 보여준다. 나머지는 펼쳐야 나온다. -->
            <TextBlock x:Name="NextMoveText" Margin="0,6,0,0" Foreground="#9C93B8" FontSize="11"
                       TextTrimming="CharacterEllipsis" Visibility="Collapsed" />

            <StackPanel x:Name="DetailPanel" Visibility="Collapsed">
                <ItemsControl x:Name="GridCells" Margin="0,10,0,0" HorizontalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="2" Width="60" Height="46" CornerRadius="4"
                                    Background="{Binding Background}"
                                    BorderBrush="{Binding BorderBrush}" BorderThickness="{Binding BorderThickness}"
                                    ToolTip="{Binding Tooltip}" ToolTipService.IsEnabled="{Binding HasTooltip}">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" Foreground="{Binding TitleBrush}"
                                               FontSize="9" TextAlignment="Center" TextWrapping="Wrap"
                                               MaxHeight="24" Margin="3,0,3,0" />
                                    <TextBlock Text="{Binding Label}" Foreground="{Binding Foreground}"
                                               FontSize="11" FontWeight="SemiBold" TextAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="LegendText" Margin="2,8,0,0" FontSize="10" Foreground="#6B6285"
                           Text="노란 테두리 = 옮겨야 할 자리" Visibility="Collapsed" />

                <StackPanel x:Name="MovePanel" Margin="0,12,0,0" Visibility="Collapsed">
                    <TextBlock Text="옮길 것" Foreground="#6B6285" FontSize="10" Margin="0,0,0,5" />
                    <ItemsControl x:Name="MoveList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,3">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}"
                                               Foreground="#7E7599" FontSize="11" Margin="8,0,0,0" />
                                    <TextBlock Text="{Binding Label}" Foreground="#C3BBD8" FontSize="11"
                                               TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel x:Name="OfferPanel" Margin="0,12,0,0" Visibility="Collapsed">
                    <TextBlock Text="지금 집을 수 있는 것" Foreground="#6B6285" FontSize="10" Margin="0,0,0,5" />
                    <ItemsControl x:Name="OfferList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,3" ToolTip="{Binding Tooltip}"
                                           ToolTipService.IsEnabled="{Binding HasTooltip}">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Gain}"
                                               Foreground="{Binding Tone}" FontSize="11" FontWeight="SemiBold"
                                               Margin="8,0,0,0" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Price}"
                                               Foreground="{Binding PriceTone}" FontSize="10"
                                               Margin="8,1,0,0" />
                                    <TextBlock Text="{Binding Name}" Foreground="{Binding NameTone}" FontSize="11"
                                               TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
