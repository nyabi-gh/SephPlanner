<Window x:Class="SephPlanner.Overlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SephPlanner.Overlay"
        Title="SephPlanner"
        Width="232" SizeToContent="Height"
        Left="16" Top="150"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        FontFamily="{x:Static local:Theme.Body}"
        FontWeight="Bold"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Aliased">

    <Window.Resources>
        <!-- 픽셀 UI에는 WPF 기본 버튼 크롬(둥근 모서리, 호버 파랑)이 어울리지 않는다. -->
        <Style x:Key="GlyphButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{x:Static local:Theme.TextDim}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{x:Static local:Theme.TextBright}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{x:Static local:Theme.Panel}" />
            <Setter Property="Foreground" Value="{x:Static local:Theme.Text}" />
            <Setter Property="BorderBrush" Value="{x:Static local:Theme.Frame}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="{x:Static local:Theme.Body}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="8,5" />
        </Style>

        <Style x:Key="PixelButton" TargetType="Button">
            <Setter Property="Foreground" Value="{x:Static local:Theme.Text}" />
            <Setter Property="FontFamily" Value="{x:Static local:Theme.Small}" />
            <Setter Property="FontSize" Value="10" />
            <!-- Galmuri9 에는 볼드가 없다. 굵기를 흉내 내면 픽셀이 뭉개진다. -->
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{x:Static local:Theme.SlotEdge}"
                                BorderBrush="{x:Static local:Theme.Frame}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{x:Static local:Theme.TextBright}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{x:Static local:Theme.TextDim}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{x:Static local:Theme.Small}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{x:Static local:Theme.TextDim}" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
    </Window.Resources>

    <!-- 게임 패널의 골격: 어두운 윤곽 - 장미빛 프레임 - 어두운 윤곽 - 불투명한 속 -->
    <Border BorderBrush="{x:Static local:Theme.Outline}" BorderThickness="2">
        <Border BorderBrush="{x:Static local:Theme.Frame}" BorderThickness="4">
            <Border BorderBrush="{x:Static local:Theme.Outline}" BorderThickness="2"
                    Background="{x:Static local:Theme.Panel}" Padding="12"
                    MouseLeftButtonDown="OnDragArea">
                <StackPanel>
                    <DockPanel LastChildFill="False">
                        <TextBlock x:Name="TitleText" Text="SephPlanner"
                                   Foreground="{x:Static local:Theme.TextBright}"
                                   FontSize="12" FontWeight="Bold"
                                   ToolTip="Ctrl+Alt+P = 접기/펼치기 · Ctrl+Alt+O = 숨기기/보이기" />
                        <Button DockPanel.Dock="Right" Content="×" Click="OnClose"
                                Style="{StaticResource GlyphButton}" Margin="6,0,0,0" FontSize="12"
                                ToolTip="닫기 (Esc)" />
                        <Button x:Name="ExpandButton" DockPanel.Dock="Right" Content="▼" Click="OnToggleDetail"
                                Style="{StaticResource GlyphButton}" Margin="6,0,0,0" FontSize="10" />
                        <Button x:Name="OpacityButton" DockPanel.Dock="Right" Content="▒" Click="OnCycleOpacity"
                                Style="{StaticResource GlyphButton}" Margin="6,0,0,0" FontSize="10" />
                        <TextBlock x:Name="StatusText" DockPanel.Dock="Right" Text="게임 대기 중"
                                   FontFamily="{x:Static local:Theme.Small}" FontSize="10" FontWeight="Normal"
                                   Foreground="{x:Static local:Theme.TextDim}" VerticalAlignment="Center" />
                    </DockPanel>

                    <TextBlock x:Name="NoticeText" Margin="0,10,0,0" TextWrapping="Wrap"
                               Foreground="{x:Static local:Theme.Amber}" FontSize="12" LineHeight="16"
                               Visibility="Collapsed" />

                    <!-- 점수는 게임 카운터와 같은 문법으로 읽힌다: 지금 / 최적 -->
                    <StackPanel x:Name="ScorePanel" Orientation="Horizontal" Margin="0,10,0,0"
                                Visibility="Collapsed">
                        <TextBlock x:Name="CurrentScoreText" FontFamily="{x:Static local:Theme.Score}"
                                   FontSize="30" FontWeight="Normal"
                                   Foreground="{x:Static local:Theme.TextDim}" />
                        <TextBlock Text="/" FontFamily="{x:Static local:Theme.Score}" FontSize="30"
                                   FontWeight="Normal"
                                   Foreground="{x:Static local:Theme.TextDim}" Margin="7,0" />
                        <TextBlock x:Name="BestScoreText" FontFamily="{x:Static local:Theme.Score}"
                                   FontSize="30" FontWeight="Normal"
                                   Foreground="{x:Static local:Theme.TextBright}" />
                        <TextBlock x:Name="GainText" FontSize="12" Margin="8,0,0,4"
                                   VerticalAlignment="Bottom" Foreground="{x:Static local:Theme.Good}" />
                    </StackPanel>

                    <!-- 접었을 때는 다음 한 수만 보여준다. 나머지는 펼쳐야 나온다. -->
                    <TextBlock x:Name="NextMoveText" Margin="0,6,0,0" FontSize="12"
                               Foreground="{x:Static local:Theme.Text}"
                               TextTrimming="CharacterEllipsis" Visibility="Collapsed" />

                    <StackPanel x:Name="DetailPanel" Visibility="Collapsed">
                        <ItemsControl x:Name="GridCells" Margin="0,10,0,0" HorizontalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="2" Width="60" Height="46"
                                            Background="{Binding Background}"
                                            BorderBrush="{Binding BorderBrush}"
                                            BorderThickness="{Binding BorderThickness}"
                                            ToolTip="{Binding Tooltip}"
                                            ToolTipService.IsEnabled="{Binding HasTooltip}"
                                            MouseRightButtonUp="OnCellRightClick">
                                        <StackPanel VerticalAlignment="Center">
                                            <Image Source="{Binding Icon}" Width="24" Height="24"
                                                   Margin="0,0,0,1"
                                                   RenderOptions.BitmapScalingMode="NearestNeighbor"
                                                   Visibility="{Binding IconVisibility}" />
                                            <TextBlock Text="{Binding Title}" Foreground="{Binding TitleBrush}"
                                                       FontFamily="{x:Static local:Theme.Small}" FontSize="10"
                                                       FontWeight="Normal" TextAlignment="Center" TextWrapping="Wrap"
                                                       MaxHeight="26" Margin="3,0,3,0"
                                                       Visibility="{Binding TitleVisibility}" />
                                            <TextBlock Text="{Binding Label}" Foreground="{Binding Foreground}"
                                                       FontSize="12" TextAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <DockPanel x:Name="LegendRow" Margin="2,8,0,0" LastChildFill="False"
                                   Visibility="Collapsed">
                            <TextBlock x:Name="LegendText"
                                       FontFamily="{x:Static local:Theme.Small}" FontSize="10" FontWeight="Normal"
                                       Foreground="{x:Static local:Theme.TextDim}"
                                       Text="노란 테두리 = 옮겨야 할 자리" VerticalAlignment="Center" />
                            <Button x:Name="IconModeButton" DockPanel.Dock="Right" Content="글자로 보기"
                                    Style="{StaticResource PixelButton}" Click="OnToggleIconMode"
                                    ToolTip="격자와 후보 목록을 아이콘 또는 글자로 보여줍니다. 아이콘은 F9로 데이터를 만든 뒤부터 나옵니다." />
                            <Button x:Name="RecommendButton" DockPanel.Dock="Right" Content="추천 끄기"
                                    Style="{StaticResource PixelButton}" Click="OnToggleRecommendations"
                                    Margin="0,0,4,0"
                                    ToolTip="무엇을 집을지에 대한 조언(후보 목록·빌드 우선)을 켜고 끕니다. 끄면 계산도 하지 않습니다. 배치 기능은 그대로 둡니다." /></DockPanel>

                        <StackPanel x:Name="MovePanel" Margin="0,12,0,0" Visibility="Collapsed">
                            <DockPanel Margin="0,0,0,5" LastChildFill="False">
                                <TextBlock Text="옮길 것" Style="{StaticResource SectionHeader}"
                                           Margin="0" VerticalAlignment="Center" />
                                <Button x:Name="AutoPlaceButton" DockPanel.Dock="Right" Content="자동 배치"
                                        Style="{StaticResource PixelButton}" Click="OnAutoPlace"
                                        Visibility="Collapsed"
                                        ToolTip="이 배치를 게임에 그대로 적용합니다. 싱글플레이에서만 동작합니다." />
                            </DockPanel>
                            <ItemsControl x:Name="MoveList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,3">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}"
                                                       Foreground="{x:Static local:Theme.TextDim}"
                                                       FontSize="12" Margin="8,0,0,0" />
                                            <TextBlock Text="{Binding Label}"
                                                       Foreground="{x:Static local:Theme.Text}" FontSize="12"
                                                       TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel x:Name="OfferPanel" Margin="0,12,0,0" Visibility="Collapsed">
                            <TextBlock Text="지금 집을 수 있는 것" Style="{StaticResource SectionHeader}"
                                       Foreground="{x:Static local:Theme.Mint}" />
                            <ItemsControl x:Name="OfferList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,3" ToolTip="{Binding Tooltip}"
                                                   ToolTipService.IsEnabled="{Binding HasTooltip}">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Gain}"
                                                       Foreground="{Binding Tone}" FontSize="12"
                                                       Margin="8,0,0,0" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Price}"
                                                       Foreground="{Binding PriceTone}"
                                                       FontFamily="{x:Static local:Theme.Small}" FontSize="10"
                                                       FontWeight="Normal" Margin="8,2,0,0" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Reach}"
                                                       Foreground="{x:Static local:Theme.TextDim}"
                                                       FontFamily="{x:Static local:Theme.Small}" FontSize="10"
                                                       FontWeight="Normal" Margin="8,2,0,0" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Combo}"
                                                       Foreground="{Binding ComboTone}"
                                                       FontFamily="{x:Static local:Theme.Small}" FontSize="10"
                                                       FontWeight="Normal" Margin="8,2,0,0" />
                                            <Image DockPanel.Dock="Left" Source="{Binding Icon}"
                                                   Width="16" Height="16" Margin="0,0,5,0"
                                                   RenderOptions.BitmapScalingMode="NearestNeighbor"
                                                   Visibility="{Binding IconVisibility}" />
                                            <TextBlock Text="{Binding Name}" Foreground="{Binding NameTone}"
                                                       FontSize="12" TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel x:Name="BuildPanel" Margin="0,12,0,0" Visibility="Collapsed">
                            <TextBlock Text="빌드 우선" Style="{StaticResource SectionHeader}" />
                            <ItemsControl x:Name="ChipList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Text}" Click="OnChipClick"
                                                Style="{StaticResource PixelButton}"
                                                Foreground="{Binding Foreground}" Margin="0,0,4,4"
                                                ToolTip="{Binding Tooltip}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Border>
</Window>
